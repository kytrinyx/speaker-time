#!/usr/bin/env python3

import os
import json
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '../lib'))
from timeline import Timeline
from language_detector import detect_file_language

import whisper

print("episode,speaker,rank,segment_id,duration,language,confidence", flush=True)

model = whisper.load_model("small")

output_root = "output"

for basename in sorted(os.listdir(output_root)):
    episode_dir = os.path.join(output_root, basename)
    if not os.path.isdir(episode_dir):
        continue

    metadata_file = os.path.join(episode_dir, "metadata.json")
    timeline_file = os.path.join(episode_dir, "timeline.csv")
    audio_dir = os.path.join(episode_dir, "audio")

    if not os.path.exists(metadata_file):
        continue
    if not os.path.exists(timeline_file):
        continue
    if not os.path.isdir(audio_dir):
        continue

    with open(metadata_file) as f:
        metadata = json.load(f)

    timeline = Timeline.load(basename)

    for speaker in sorted(metadata):
        candidates = [
            (end - start, idx)
            for idx, (spk, start, end) in enumerate(timeline._segments)
            if spk == speaker and end - start
        ]

        if not candidates:
            continue

        candidates.sort(reverse=True)
        top5 = candidates[:5]

        found_high_confidence = False

        for rank, (duration, idx) in enumerate(top5, start=1):
            segment_id = f"{idx + 1:06d}"
            audio_file = os.path.join(audio_dir, f"{segment_id}.mp3")

            if found_high_confidence or not os.path.exists(audio_file):
                print(f"{basename},{speaker},{rank},{segment_id},{duration:.2f},-,-", flush=True)
                continue

            result = detect_file_language(audio_file, model)
            language = result["language"]
            confidence = result["confidence"]

            print(f"{basename},{speaker},{rank},{segment_id},{duration:.2f},{language},{confidence:.4f}", flush=True)

            if confidence >= 0.9:
                found_high_confidence = True

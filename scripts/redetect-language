#!/usr/bin/env python3

import os
import sys
import glob

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "../lib"))
from timeline import Timeline
from language_detector import SerialLanguageDetector, ConcatenatingLanguageDetector

import whisper


def detect_speaker(episode_id, speaker_id, model):
    timeline = Timeline.load(episode_id)
    segments = [s for s in timeline._segments if s.speaker_id == speaker_id]

    log_dir = os.path.join("output", episode_id, "language_detection")
    os.makedirs(log_dir, exist_ok=True)
    log_path = os.path.join(log_dir, f"{speaker_id}.log.json")

    detector = SerialLanguageDetector(segments)
    language = detector.detect(model)
    detector.write_log(log_path)

    if language is None:
        concat_path = os.path.join(log_dir, f"{speaker_id}.concatenated.mp3")
        detector = ConcatenatingLanguageDetector(segments)
        language = detector.detect(model, concat_path)
        detector.write_log(log_path)

    return language


def main():
    output_dir = "output"
    patterns = ["jeep-*", "katrina-*", "ian-*"]

    basenames = []
    for pattern in patterns:
        matches = glob.glob(os.path.join(output_dir, pattern))
        basenames.extend(os.path.basename(m) for m in matches if os.path.isdir(m))
    basenames.sort()

    basenames = [b for b in basenames if os.path.exists(os.path.join(output_dir, b, "timeline.csv"))]

    if not basenames:
        print("No episodes found.")
        sys.exit(1)

    model = whisper.load_model("small")

    for episode_id in basenames:
        timeline = Timeline.load(episode_id)
        speakers = sorted({s.speaker_id for s in timeline._segments})

        for speaker_id in speakers:
            print(f"{episode_id} / {speaker_id} ...", end=" ", flush=True)
            language = detect_speaker(episode_id, speaker_id, model)
            print(language)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3

import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "../lib"))
from timeline import Timeline


AIRTIME_THRESHOLD = 2.0  # percent


def main():
    output_dir = "output"
    episodes = sorted(os.listdir(output_dir))

    artifact_speakers = []

    for episode in episodes:
        timeline_path = os.path.join(output_dir, episode, "timeline.csv")
        if not os.path.exists(timeline_path):
            continue

        timeline = Timeline.load(episode)
        distribution = timeline.airtime_distribution()

        for speaker, pct in distribution.items():
            if pct < AIRTIME_THRESHOLD:
                audio_paths = [
                    s.audio_path
                    for s in timeline._segments
                    if s.speaker_id == speaker
                ]
                artifact_speakers.append({
                    "episode": episode,
                    "speaker": speaker,
                    "audio_paths": audio_paths,
                })

    os.makedirs("data", exist_ok=True)
    output_path = "data/artifact-speakers.json"
    with open(output_path, "w") as f:
        json.dump(artifact_speakers, f, indent=2)

    print(f"Found {len(artifact_speakers)} artifact speakers across {len(episodes)} episodes")
    print(f"Written to {output_path}")


if __name__ == "__main__":
    main()

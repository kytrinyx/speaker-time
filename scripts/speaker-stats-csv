#!/usr/bin/env python3

import sys
import os
import csv
import json
import glob

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
from timeline import Timeline


def main():
    output_dir = "output"
    patterns = ["jeep-*", "katrina-*"]

    basenames = []
    for pattern in patterns:
        matches = glob.glob(os.path.join(output_dir, pattern))
        basenames.extend(os.path.basename(m) for m in matches if os.path.isdir(m))
    basenames.sort()

    fieldnames = [
        "episode", "speaker", "language", "confidence",
        "airtime_seconds", "airtime_pct", "segments", "long_segments",
        "longest", "mean", "stddev",
    ]

    writer = csv.DictWriter(sys.stdout, fieldnames=fieldnames)
    writer.writeheader()

    for basename in basenames:
        timeline_file = os.path.join(output_dir, basename, "timeline.csv")
        metadata_file = os.path.join(output_dir, basename, "metadata.json")

        if not os.path.exists(timeline_file) or not os.path.exists(metadata_file):
            continue

        with open(metadata_file) as f:
            metadata = json.load(f)

        timeline = Timeline.load(basename)
        distribution = timeline.airtime_distribution()

        for speaker in sorted(distribution):
            lang_data = metadata.get(speaker, {})
            stats = timeline.segment_stats(speaker)
            seg_count = sum(1 for spk, _, _ in timeline._segments if spk == speaker)
            long_count = sum(1 for spk, start, end in timeline._segments if spk == speaker and end - start >= 30)

            writer.writerow({
                "episode": basename,
                "speaker": speaker,
                "language": lang_data.get("language", "?"),
                "confidence": round(lang_data.get("confidence", 0.0), 3),
                "airtime_seconds": round(timeline.airtime(speaker), 3),
                "airtime_pct": round(distribution[speaker], 2),
                "segments": seg_count,
                "long_segments": long_count,
                "longest": round(stats["longest"], 2),
                "mean": round(stats["mean"], 2),
                "stddev": round(stats["stddev"], 2),
            })


if __name__ == "__main__":
    main()

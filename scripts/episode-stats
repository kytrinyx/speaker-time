#!/usr/bin/env python3

import sys
import os
import json

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
from timeline import Timeline


def format_duration(seconds):
    hours = int(seconds // 3600)
    minutes = int((seconds % 3600) // 60)
    secs = seconds % 60
    return f"{hours:02d}:{minutes:02d}:{secs:06.3f}"


def main():
    if len(sys.argv) != 2:
        print("Usage: episode-speakers <basename>")
        sys.exit(1)

    basename = sys.argv[1]

    timeline_file = os.path.join("output", basename, "timeline.csv")
    metadata_file = os.path.join("output", basename, "metadata.json")

    if not os.path.exists(timeline_file):
        print(f"Error: Timeline file not found: {timeline_file}")
        sys.exit(1)

    if not os.path.exists(metadata_file):
        print(f"Error: Metadata file not found: {metadata_file}")
        sys.exit(1)

    with open(metadata_file) as f:
        metadata = json.load(f)

    timeline = Timeline.load(basename)
    distribution = timeline.airtime_distribution()

    speakers = sorted(distribution, key=lambda s: timeline.airtime(s), reverse=True)

    for speaker in speakers:
        lang_data = metadata.get(speaker, {})
        lang = lang_data.get("language", "?")
        conf = lang_data.get("confidence", 0.0)
        airtime = timeline.airtime(speaker)
        pct = distribution[speaker]
        stats = timeline.segment_stats(speaker)
        seg_count = sum(1 for spk, _, _ in timeline._segments if spk == speaker)
        long_count = sum(1 for spk, start, end in timeline._segments if spk == speaker and end - start >= 30)

        print(f"{speaker}  {lang}  conf: {conf:.3f}")
        print(f"  airtime: {format_duration(airtime)} ({pct:.1f}%)  segments: {seg_count}  long: {long_count}")
        print(f"  longest: {stats['longest']:.1f}s  mean: {stats['mean']:.1f}s  stddev: {stats['stddev']:.1f}s")
        print()


if __name__ == "__main__":
    main()

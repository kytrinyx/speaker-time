#!/usr/bin/env python3

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "../lib"))
from timeline import Timeline
from language_detector import SerialLanguageDetector, ConcatenatingLanguageDetector

import whisper


def main():
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <episode_id> <speaker_id>")
        sys.exit(1)

    episode_id = sys.argv[1]
    speaker_id = sys.argv[2]

    timeline = Timeline.load(episode_id)
    segments = [s for s in timeline._segments if s.speaker_id == speaker_id]

    model = whisper.load_model("small")

    log_dir = os.path.join("output", episode_id, "language_detection")
    os.makedirs(log_dir, exist_ok=True)
    log_path = os.path.join(log_dir, f"{speaker_id}.log.json")

    detector = SerialLanguageDetector(segments)
    language = detector.detect(model)
    detector.write_log(log_path)

    if language is None:
        concat_path = os.path.join(log_dir, f"{speaker_id}.concatenated.mp3")
        detector = ConcatenatingLanguageDetector(segments)
        language = detector.detect(model, concat_path)
        detector.write_log(log_path)

    print(language)


if __name__ == "__main__":
    main()

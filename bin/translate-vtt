#!/usr/bin/env python3

import sys
import os
import json
import shutil
import time
import urllib.request
import urllib.error
from datetime import datetime

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.captions import Captions
from halfhalf.cue import Cue
from halfhalf.prompts import cohost_for, translate_ko_en, translate_en_ko
from halfhalf import paths


REPLICATE_MODEL = "anthropic/claude-4.5-haiku"
REPLICATE_API_URL = f"https://api.replicate.com/v1/models/{REPLICATE_MODEL}/predictions"
CHUNK_SIZE = 100


def call_replicate(user):
    api_key = os.environ.get("REPLICATE_API_TOKEN")
    if not api_key:
        print("Error: REPLICATE_API_TOKEN environment variable not set")
        sys.exit(1)

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    }

    payload = json.dumps({"input": {"prompt": user, "max_tokens": 16384}}).encode("utf-8")
    req = urllib.request.Request(REPLICATE_API_URL, data=payload, headers=headers, method="POST")
    with urllib.request.urlopen(req) as resp:
        data = json.loads(resp.read().decode("utf-8"))

    prediction_id = data["id"]
    poll_url = f"https://api.replicate.com/v1/predictions/{prediction_id}"

    while True:
        req = urllib.request.Request(poll_url, headers=headers)
        with urllib.request.urlopen(req) as resp:
            data = json.loads(resp.read().decode("utf-8"))

        status = data["status"]
        if status == "succeeded":
            return "".join(data["output"])
        elif status == "failed":
            raise RuntimeError(f"Replicate prediction failed: {data.get('error')}")

        time.sleep(1)


def translate_chunk(lines, source_lang, target_lang, cohost, log_path, bad_json_path):
    payload = [{"id": i + 1, "text": text} for i, text in enumerate(lines)]
    n = len(lines)

    payload_json = json.dumps(payload, ensure_ascii=False)
    if source_lang == "ko" and target_lang == "en":
        user = translate_ko_en(cohost, n, payload_json)
    else:
        user = translate_en_ko(cohost, n, payload_json)

    text = call_replicate(user).strip()
    if text.startswith("```"):
        text = text.split("\n", 1)[1].rsplit("```", 1)[0].strip()

    try:
        result = json.loads(text)
    except json.JSONDecodeError:
        from json_repair import repair_json
        result = repair_json(text, return_objects=True)
        # flatten list-of-lists (e.g. stray ] split the array into segments)
        if isinstance(result, list) and any(isinstance(el, list) for el in result):
            flat = []
            for el in result:
                if isinstance(el, list):
                    flat.extend(el)
                elif isinstance(el, dict):
                    flat.append(el)
            result = flat
        if not (isinstance(result, list) and all(isinstance(el, dict) for el in result)):
            os.makedirs(os.path.dirname(bad_json_path), exist_ok=True)
            with open(bad_json_path, "w") as f:
                f.write(text)
            raise
        print(f"  Repaired JSON ({len(result)} items recovered)")

    seen_ids = set()
    duplicate_ids = set()
    for item in result:
        if item["id"] in seen_ids:
            duplicate_ids.add(item["id"])
        seen_ids.add(item["id"])

    translated = {item["id"]: item["text"] for item in result if item["id"] not in duplicate_ids}

    expected_ids = set(range(1, n + 1))
    missing = sorted(expected_ids - set(translated.keys()))

    if duplicate_ids or missing:
        mismatch_parts = []
        if duplicate_ids:
            mismatch_parts.append(f"duplicate ids (skipped): {sorted(duplicate_ids)}")
        if missing:
            mismatch_parts.append(f"missing ids: {missing}")
        mismatch_parts.append(f"sent {n} lines, got {len(result)} back")
        log_entry = {
            "payload": payload,
            "response": result,
            "mismatch": "; ".join(mismatch_parts),
        }
        os.makedirs(os.path.dirname(log_path), exist_ok=True)
        with open(log_path, "w") as f:
            json.dump(log_entry, f, ensure_ascii=False, indent=2)
        raise ValueError(f"chunk mismatch (see {log_path})")

    return [translated[i + 1] for i in range(n)]


def translate_lines(lines, source_lang, target_lang, cohost, cache_file, log_path, ts):
    cache = {}
    if os.path.exists(cache_file):
        with open(cache_file) as f:
            cache = json.load(f)

    uncached = [line for line in lines if line not in cache]
    chunks = [uncached[i:i + CHUNK_SIZE] for i in range(0, len(uncached), CHUNK_SIZE)]

    cached_count = len(lines) - len(uncached)
    if cached_count:
        print(f"  {cached_count} lines cached, {len(uncached)} to translate")

    logs_dir = os.path.dirname(log_path)
    for idx, chunk in enumerate(chunks):
        print(f"  Chunk {idx + 1}/{len(chunks)} ({len(chunk)} lines)...")
        bad_json_path = os.path.join(logs_dir, f"translation.{source_lang}-{target_lang}.{idx + 1}.{ts}.bad.json")
        try:
            translated = translate_chunk(chunk, source_lang, target_lang, cohost, log_path, bad_json_path)
        except json.JSONDecodeError:
            print(f"  Warning: chunk {idx + 1} returned invalid JSON, skipping (see {bad_json_path})")
            continue
        except ValueError as e:
            print(f"  Warning: chunk {idx + 1} failed ({e}), skipping")
            continue
        for source, result in zip(chunk, translated):
            cache[source] = result
        os.makedirs(os.path.dirname(cache_file), exist_ok=True)
        with open(cache_file, "w") as f:
            json.dump(cache, f, ensure_ascii=False)

    return [cache.get(line) for line in lines]


def write_vtt(cues, translated_texts, path):
    with open(path, "w") as f:
        f.write("WEBVTT\n\n")
        for cue, text in zip(cues, translated_texts):
            if not text.strip():
                continue
            f.write(f"{Cue.format_timestamp(cue.start)} --> {Cue.format_timestamp(cue.end)}\n")
            f.write(f"{text}\n\n")


def main():
    if len(sys.argv) != 2:
        print("Usage: translate-vtt <episode_id>")
        print("Example: translate-vtt jeep-ep-001")
        sys.exit(1)

    episode_id = sys.argv[1]
    output_dir = paths.episode_dir(episode_id)
    episode_subtitles_dir = paths.subtitles_dir(episode_id)
    os.makedirs(episode_subtitles_dir, exist_ok=True)
    cohost = cohost_for(episode_id)
    subtitles_dir = os.environ.get("HALF_AND_HALF_SUBTITLES_DIR", os.path.expanduser("~/Desktop/"))

    all_cues = list(Captions.load(episode_id))
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")

    for source_lang, target_lang in (("ko", "en"), ("en", "ko")):
        output_file = paths.vtt_file(episode_id, source_lang, target_lang)
        cues = [c for c in all_cues if c.language == source_lang]
        lines = [c.text for c in cues]
        cache_file = paths.translation_cache(episode_id, source_lang, target_lang)
        log_path = os.path.join(paths.logs_dir(episode_id), f"translate-{source_lang}-{target_lang}.{ts}.json")

        cache = {}
        if os.path.exists(cache_file):
            with open(cache_file) as f:
                cache = json.load(f)

        if all(line in cache for line in lines):
            print(f"Writing {source_lang}->{target_lang} from cache")
            write_vtt(cues, [cache[line] for line in lines], output_file)
            shutil.copy(output_file, subtitles_dir)
            continue

        print(f"Translating {source_lang}->{target_lang} ({len(lines)} lines)")
        translated = translate_lines(lines, source_lang, target_lang, cohost, cache_file, log_path, ts)

        missing_count = sum(1 for t in translated if t is None)
        if missing_count:
            print(f"  Skipping {source_lang}->{target_lang} VTT: {missing_count}/{len(lines)} lines missing")
            continue

        write_vtt(cues, translated, output_file)

        print(f"Translation written: {output_file}")
        shutil.copy(output_file, subtitles_dir)
        print(f"Copied {os.path.basename(output_file)} to {subtitles_dir}")


if __name__ == "__main__":
    main()

#!/usr/bin/env python3

import sys
import os

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.captions import Captions


def main():
    if len(sys.argv) != 2:
        print("Usage: create-vtt <episode_id>")
        print("Example: create-vtt sample")
        sys.exit(1)

    episode_id = sys.argv[1]
    vtt_file = os.path.join("output", episode_id, f"{episode_id}.vtt")

    captions = Captions.load(episode_id)
    cues = list(captions)

    with open(vtt_file, "w") as f:
        f.write("WEBVTT\n\n")
        for cue in cues:
            f.write(f"{cue}\n\n")

    print(f"VTT file created: {vtt_file}")
    print(f"Generated {len(cues)} cues")

if __name__ == "__main__":
    main()

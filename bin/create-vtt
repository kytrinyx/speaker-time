#!/usr/bin/env python3

import sys
import os
import json
import re

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.cue import Cue
from halfhalf.transcript import Transcript


def is_filler(text, lang):
    if lang == "ko":
        return bool(re.fullmatch(r'[ㅋㅎ아어고으\s]+', text))
    return bool(re.fullmatch(r'[hH][aAeE]+([hH][aAeE]*)*[\s!.]*', text))


def main():
    if len(sys.argv) != 2:
        print("Usage: create-vtt <episode_id>")
        print("Example: create-vtt sample")
        sys.exit(1)

    episode_id = sys.argv[1]

    cache_file = os.path.join("output", episode_id, "split_segments.json")
    vtt_file = os.path.join("output", episode_id, f"{episode_id}.vtt")

    # Load split segments cache if available
    split_cache = {}
    if os.path.exists(cache_file):
        with open(cache_file) as f:
            split_cache = json.load(f)

    transcript = Transcript.load(episode_id)
    cues = []
    segment_count = 0
    for row in transcript:
        text = row["text"].strip()
        lang = row.get("language", "")
        sid = int(row["segment_id"])
        if not text or text == "[TIMEOUT]" or is_filler(text, lang) or transcript.low_confidence(sid, lang):
            continue
        segment_count += 1

        cached = split_cache.get(str(sid))
        if cached:
            for c in cached["cues"]:
                cues.append(Cue(c["start"], c["end"], c["text"]))
        else:
            cues.append(Cue(float(row["start_time"]), float(row["end_time"]), text))

    # Generate VTT file
    with open(vtt_file, "w") as f:
        f.write("WEBVTT\n\n")
        for cue in cues:
            f.write(f"{cue}\n\n")

    print(f"VTT file created: {vtt_file}")
    print(f"Generated {len(cues)} cues from {segment_count} segments")

if __name__ == "__main__":
    main()

#!/usr/bin/env python3

import sys
import os
import csv

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '../lib'))
from cue_splitter import Word, Segment, HybridSplit


def format_timestamp(seconds):
    """Convert seconds to VTT timestamp format (HH:MM:SS.mmm)."""
    hours = int(seconds // 3600)
    minutes = int((seconds % 3600) // 60)
    secs = seconds % 60
    return f"{hours:02d}:{minutes:02d}:{secs:06.3f}"

def main():
    if len(sys.argv) != 2:
        print("Usage: create-vtt <basename>")
        print("Example: create-vtt sample")
        sys.exit(1)

    basename = sys.argv[1]

    # Construct paths
    transcription_file = os.path.join("output", basename, "transcription.csv")
    words_file = os.path.join("output", basename, "words.csv")
    vtt_file = os.path.join("output", basename, f"{basename}.vtt")

    # Check if transcription file exists
    if not os.path.exists(transcription_file):
        print(f"Error: Transcription file not found: {transcription_file}")
        sys.exit(1)

    # Read word-level timings if available
    words_by_segment = {}
    if os.path.exists(words_file):
        with open(words_file) as f:
            for row in csv.DictReader(f):
                sid = int(row["segment_id"])
                words_by_segment.setdefault(sid, []).append(
                    Word(row["word"], float(row["start_time"]), float(row["end_time"]))
                )

    # Read transcription CSV and build Segment objects
    segments = []
    with open(transcription_file) as f:
        for row in csv.DictReader(f):
            text = row["text"].strip()
            if not text or text == "[TIMEOUT]":
                continue
            sid = int(row["segment_id"])
            segments.append(Segment(
                id=sid,
                start=float(row["start_time"]),
                end=float(row["end_time"]),
                text=text,
                language=row.get("language", ""),
                words=words_by_segment.get(sid, []),
            ))

    # Apply HybridSplit if words are available, otherwise one cue per segment
    if words_by_segment:
        splitter = HybridSplit()
        cues = []
        for seg in segments:
            cues.extend(splitter.split(seg))
    else:
        from cue_splitter import Cue
        cues = [Cue(seg.start, seg.end, seg.text) for seg in segments]

    # Generate VTT file
    with open(vtt_file, "w") as f:
        f.write("WEBVTT\n\n")
        for cue in cues:
            f.write(f"{format_timestamp(cue.start)} --> {format_timestamp(cue.end)}\n")
            f.write(f"{cue.text}\n\n")

    print(f"VTT file created: {vtt_file}")
    print(f"Generated {len(cues)} cues from {len(segments)} segments")

if __name__ == "__main__":
    main()

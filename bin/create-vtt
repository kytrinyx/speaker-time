#!/usr/bin/env python3

import sys
import os
import shutil

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.captions import Captions


def main():
    if len(sys.argv) != 2:
        print("Usage: create-vtt <episode_id>")
        print("Example: create-vtt sample")
        sys.exit(1)

    episode_id = sys.argv[1]

    captions = Captions.load(episode_id)
    cues = list(captions)

    subtitles_dir = os.environ.get("FINAL_HALF_AND_HALF_SUBTITLES_DIR", os.path.expanduser("~/Desktop/"))
    for lang in ("ko", "en"):
        lang_cues = [c for c in cues if c.language == lang]
        vtt_file = os.path.join("output", episode_id, f"{episode_id}.{lang}-{lang}.vtt")
        with open(vtt_file, "w") as f:
            f.write("WEBVTT\n\n")
            for cue in lang_cues:
                f.write(f"{cue}\n\n")
        print(f"VTT file created: {vtt_file} ({len(lang_cues)} cues)")
        shutil.copy(vtt_file, subtitles_dir)
        print(f"Copied {os.path.basename(vtt_file)} to {subtitles_dir}")

if __name__ == "__main__":
    main()

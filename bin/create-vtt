#!/usr/bin/env python3

import sys
import os
import csv
import json
import re

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '../lib'))
from segment_splitter import Cue


def is_filler(text, lang):
    if lang == "ko":
        return bool(re.fullmatch(r'[ㅋㅎ아어고으\s]+', text))
    return bool(re.fullmatch(r'[hH][aAeE]+([hH][aAeE]*)*[\s!.]*', text))


def format_timestamp(seconds):
    """Convert seconds to VTT timestamp format (HH:MM:SS.mmm)."""
    hours = int(seconds // 3600)
    minutes = int((seconds % 3600) // 60)
    secs = seconds % 60
    return f"{hours:02d}:{minutes:02d}:{secs:06.3f}"

def main():
    if len(sys.argv) != 2:
        print("Usage: create-vtt <basename>")
        print("Example: create-vtt sample")
        sys.exit(1)

    basename = sys.argv[1]

    transcription_file = os.path.join("output", basename, "transcription.csv")
    cache_file = os.path.join("output", basename, "split_segments.json")
    vtt_file = os.path.join("output", basename, f"{basename}.vtt")

    if not os.path.exists(transcription_file):
        print(f"Error: Transcription file not found: {transcription_file}")
        sys.exit(1)

    # Load split segments cache if available
    split_cache = {}
    if os.path.exists(cache_file):
        with open(cache_file) as f:
            split_cache = json.load(f)

    # Read transcription CSV and emit cues
    cues = []
    segment_count = 0
    with open(transcription_file) as f:
        for row in csv.DictReader(f):
            text = row["text"].strip()
            lang = row.get("language", "")
            if not text or text == "[TIMEOUT]" or is_filler(text, lang):
                continue
            sid = int(row["segment_id"])
            segment_count += 1

            cached = split_cache.get(str(sid))
            if cached:
                for c in cached["cues"]:
                    cues.append(Cue(c["start"], c["end"], c["text"]))
            else:
                cues.append(Cue(float(row["start_time"]), float(row["end_time"]), text))

    # Generate VTT file
    with open(vtt_file, "w") as f:
        f.write("WEBVTT\n\n")
        for cue in cues:
            f.write(f"{format_timestamp(cue.start)} --> {format_timestamp(cue.end)}\n")
            f.write(f"{cue.text}\n\n")

    print(f"VTT file created: {vtt_file}")
    print(f"Generated {len(cues)} cues from {segment_count} segments")

if __name__ == "__main__":
    main()

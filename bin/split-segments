#!/usr/bin/env python3

import sys
import os
import csv
import json
from dataclasses import replace

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.word import Word
from halfhalf.segment_splitter import HybridSplit
from halfhalf.transcript import Transcript
from halfhalf import paths


def main():
    if len(sys.argv) != 2:
        print("Usage: split-segments <episode_id>")
        sys.exit(1)

    episode_id = sys.argv[1]

    words_file = paths.words_csv(episode_id)
    cache_file = paths.split_segments_json(episode_id)

    if not os.path.exists(words_file):
        print("No words file found; nothing to split.")
        return

    # Load existing cache
    cache = {}
    if os.path.exists(cache_file):
        with open(cache_file) as f:
            cache = json.load(f)

    # Read word-level timings
    words_by_segment = {}
    with open(words_file) as f:
        for row in csv.DictReader(f):
            sid = int(row["segment_id"])
            lang = row.get("language", "")
            words_by_segment.setdefault((sid, lang), []).append(
                Word(row["word"], float(row["start_time"]), float(row["end_time"]))
            )

    transcript = Transcript.load(episode_id)
    segments = []
    for seg in transcript:
        if (seg.id, seg.language) not in words_by_segment:
            continue
        segments.append(replace(seg, words=words_by_segment[(seg.id, seg.language)]))

    splitter = HybridSplit(episode_id=episode_id)
    split_count = 0
    skip_count = 0

    for seg in segments:
        key = str(seg.id)
        if key in cache and cache[key]["source"] == seg.raw_text:
            skip_count += 1
            continue

        cues = splitter.split(seg)
        if len(cues) > 1:
            cache[key] = {
                "source": seg.raw_text,
                "cues": [{"text": c.text, "start": c.start, "end": c.end} for c in cues],
            }
            split_count += 1
        elif key in cache:
            del cache[key]

    os.makedirs(os.path.dirname(cache_file), exist_ok=True)
    with open(cache_file, "w") as f:
        json.dump(cache, f, ensure_ascii=False, indent=2)

    print(f"Split segments saved to: {cache_file}")
    print(f"Split {split_count} segments, skipped {skip_count} unchanged")


if __name__ == "__main__":
    main()

#!/usr/bin/env python3

import sys
import os
import csv
import json

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.segment_splitter import Word, TranscriptionSegment, HybridSplit
from halfhalf.transcript import Transcript


def main():
    if len(sys.argv) != 2:
        print("Usage: split-segments <basename>")
        sys.exit(1)

    basename = sys.argv[1]

    words_file = os.path.join("output", basename, "words.csv")
    cache_file = os.path.join("output", basename, "split_segments.json")

    if not os.path.exists(words_file):
        print("No words file found; nothing to split.")
        return

    # Load existing cache
    cache = {}
    if os.path.exists(cache_file):
        with open(cache_file) as f:
            cache = json.load(f)

    # Read word-level timings
    words_by_segment = {}
    with open(words_file) as f:
        for row in csv.DictReader(f):
            sid = int(row["segment_id"])
            lang = row.get("language", "")
            words_by_segment.setdefault((sid, lang), []).append(
                Word(row["word"], float(row["start_time"]), float(row["end_time"]))
            )

    transcript = Transcript.load(basename)
    segments = []
    for row in transcript:
        text = row["text"].strip()
        lang = row.get("language", "")
        if not text or text == "[TIMEOUT]":
            continue
        sid = int(row["segment_id"])
        if (sid, lang) not in words_by_segment:
            continue
        seg = TranscriptionSegment(
            id=sid,
            start=float(row["start_time"]),
            end=float(row["end_time"]),
            text=text,
            language=lang,
            words=words_by_segment[(sid, lang)],
        )
        if not seg.is_filler():
            segments.append(seg)

    splitter = HybridSplit()
    split_count = 0
    skip_count = 0

    for seg in segments:
        key = str(seg.id)
        if key in cache and cache[key]["source"] == seg.text:
            skip_count += 1
            continue

        cues = splitter.split(seg)
        cache[key] = {
            "source": seg.text,
            "cues": [{"text": c.text, "start": c.start, "end": c.end} for c in cues],
        }
        split_count += 1

    with open(cache_file, "w") as f:
        json.dump(cache, f, ensure_ascii=False, indent=2)

    print(f"Split segments saved to: {cache_file}")
    print(f"Split {split_count} segments, skipped {skip_count} unchanged")


if __name__ == "__main__":
    main()

#!/usr/bin/env python3

import sys
import os
import json
import shutil
import datetime
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.transcript import Transcript
from halfhalf.prompts import build_prompts
from halfhalf.transcriber import Transcriber
from halfhalf.words import Words
from halfhalf.timeline import Timeline


def main():
    if len(sys.argv) != 2:
        print("Usage: transcribe <episode_id>")
        sys.exit(1)

    episode_id = sys.argv[1]
    prompts = build_prompts(episode_id)

    output_dir = os.path.join("output", episode_id)
    timeline_file = os.path.join(output_dir, "timeline.csv")
    metadata_file = os.path.join(output_dir, "metadata.json")
    audio_dir = os.path.join(output_dir, "audio")

    if not os.path.exists(timeline_file):
        print(f"Error: Timeline CSV not found: {timeline_file}")
        print("Run 'diarize' first to generate the timeline.")
        sys.exit(1)

    if not os.path.exists(audio_dir):
        print(f"Error: Audio segments directory not found: {audio_dir}")
        print("Run 'cut-audio' first to generate audio segments.")
        sys.exit(1)

    speaker_languages = {}
    speaker_skip = {}
    if os.path.exists(metadata_file):
        with open(metadata_file, 'r') as f:
            metadata = json.load(f)
            for speaker, data in metadata.items():
                if not isinstance(data, dict):
                    continue
                speaker_languages[speaker] = data.get("language", "en")
                speaker_skip[speaker] = data.get("skip", False)

    timeline = Timeline.load(episode_id)
    words_file = os.path.join(output_dir, "words.csv")
    transcript = Transcript.load(episode_id)
    words_csv = Words.load(words_file)

    timestamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    if os.path.exists(transcript.path):
        backup = os.path.join(output_dir, f"bk.{timestamp}.transcription.csv")
        shutil.copy2(transcript.path, backup)
        print(f"Backed up transcription.csv to {os.path.basename(backup)}")
    if os.path.exists(words_file):
        backup = os.path.join(output_dir, f"bk.{timestamp}.words.csv")
        shutil.copy2(words_file, backup)
        print(f"Backed up words.csv to {os.path.basename(backup)}")

    transcriber = Transcriber(prompts, transcript, words_csv)

    print("Transcribing audio segments...")
    transcribed_count = 0

    for seg in timeline:
        if speaker_skip.get(seg.speaker_id, False):
            continue
        language = speaker_languages.get(seg.speaker_id, "en")

        if not transcriber.needs_transcription(seg.segment_id, language):
            continue

        if not os.path.exists(seg.audio_path):
            print(f"Warning: Audio segment {seg.audio_path} not found")
            continue

        print(f"Transcribing segment {seg.segment_id:06d} ({seg.speaker_id})...")
        try:
            rows, words = transcriber.transcribe_segment(
                seg.audio_path, seg.segment_id, seg.speaker_id, language,
                seg.start, seg.end,
            )
        except Exception as e:
            print(f"Error transcribing segment {seg.segment_id:06d}: {e}")
            continue

        for row in rows:
            transcript.upsert(row)
        transcript.save()

        languages = {row['language'] for row in rows}
        words_csv.upsert_segment(seg.segment_id, words, languages)
        words_csv.save()

        transcribed_count += 1

    print(f"Transcription saved to: {transcript.path}")
    print(f"Transcribed {transcribed_count} new segments")

if __name__ == "__main__":
    main()

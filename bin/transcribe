#!/usr/bin/env python3

import sys
import os
import csv
import json
import whisper
import torch
import signal
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from lib.transcript import Transcript

def main():
    if len(sys.argv) != 2:
        print("Usage: transcribe <basename>")
        sys.exit(1)

    base_name = sys.argv[1]

    output_dir = os.path.join("output", base_name)
    timeline_file = os.path.join(output_dir, "timeline.csv")
    metadata_file = os.path.join(output_dir, "metadata.json")
    audio_dir = os.path.join(output_dir, "audio")

    # Check if required files exist
    if not os.path.exists(timeline_file):
        print(f"Error: Timeline CSV not found: {timeline_file}")
        print("Run 'diarize' first to generate the timeline.")
        sys.exit(1)

    if not os.path.exists(audio_dir):
        print(f"Error: Audio segments directory not found: {audio_dir}")
        print("Run 'cut-audio' first to generate audio segments.")
        sys.exit(1)

    print("Transcribing audio segments...")

    # Load Whisper model with GPU detection
    device = "cuda" if torch.cuda.is_available() else "cpu"
    use_fp16 = device == "cuda"
    model = whisper.load_model("small", device=device)

    # Load metadata for language hints and skip flags
    speaker_languages = {}
    speaker_skip = {}
    if os.path.exists(metadata_file):
        with open(metadata_file, 'r') as f:
            metadata = json.load(f)
            for speaker, data in metadata.items():
                speaker_languages[speaker] = data.get("language", "en")
                speaker_skip[speaker] = data.get("skip", False)

    # Load timeline data
    timeline_data = []
    with open(timeline_file, 'r') as csvfile:
        reader = csv.DictReader(csvfile)
        for row in reader:
            timeline_data.append(row)

    transcription_file = os.path.join(output_dir, "transcription.csv")
    words_file = os.path.join(output_dir, "words.csv")
    transcript = Transcript.load(transcription_file)

    if not os.path.exists(words_file):
        with open(words_file, 'w', newline='') as csvfile:
            fieldnames = ['segment_id', 'word_index', 'word', 'start_time', 'end_time', 'probability']
            writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
            writer.writeheader()

    # Transcribe each audio segment
    transcribed_count = 0

    for i, timeline_row in enumerate(timeline_data, 1):
        speaker_id = timeline_row['SPEAKER_ID']
        if speaker_skip.get(speaker_id, False):
            continue
        language = speaker_languages.get(speaker_id, "en")

        if transcript.contains(i, language):
            continue

        segment_file = os.path.join(audio_dir, f"{i:06d}.mp3")

        if not os.path.exists(segment_file):
            print(f"Warning: Audio segment {segment_file} not found")
            continue

        transcription_row = None
        word_rows = []

        try:
            def timeout_handler(signum, frame):
                raise TimeoutError("Transcription timeout")

            # Set timeout for individual segment (30 seconds per segment)
            signal.signal(signal.SIGALRM, timeout_handler)
            signal.alarm(30)

            try:
                result = model.transcribe(segment_file, language=language, fp16=use_fp16, word_timestamps=True)
                signal.alarm(0)  # Cancel timeout

                transcription_row = {
                    'speaker_id': speaker_id,
                    'segment_id': i,
                    'start_time': timeline_row['start_time'],
                    'end_time': timeline_row['end_time'],
                    'text': result['text'].strip(),
                    'language': language,
                    'confidence': float(result.get('segments', [{}])[0].get('avg_logprob', 0.0)) if result.get('segments') else 0.0
                }

                segment_offset = float(timeline_row['start_time'])
                word_index = 0
                for whisper_segment in result.get('segments', []):
                    for word_info in whisper_segment.get('words', []):
                        word_rows.append({
                            'segment_id': i,
                            'word_index': word_index,
                            'word': word_info['word'],
                            'start_time': round(segment_offset + word_info['start'], 3),
                            'end_time': round(segment_offset + word_info['end'], 3),
                            'probability': round(word_info.get('probability', 0.0), 4),
                        })
                        word_index += 1

                print(f"Transcribed segment {i:06d} ({speaker_id}): {result['text'].strip()[:50]}...")

            except TimeoutError:
                signal.alarm(0)  # Cancel timeout
                print(f"Timeout transcribing segment {i:06d} (30s limit exceeded)")
                transcription_row = {
                    'speaker_id': speaker_id,
                    'segment_id': i,
                    'start_time': timeline_row['start_time'],
                    'end_time': timeline_row['end_time'],
                    'text': "[TIMEOUT]",
                    'language': language,
                    'confidence': 0.0
                }

        except Exception as e:
            print(f"Error transcribing segment {i:06d}: {e}")
            transcription_row = {
                'speaker_id': speaker_id,
                'segment_id': i,
                'start_time': timeline_row['start_time'],
                'end_time': timeline_row['end_time'],
                'text': "",
                'language': language,
                'confidence': 0.0
            }

        if transcription_row:
            transcript.upsert(transcription_row)
            transcript.save()
            if word_rows:
                with open(words_file, 'a', newline='') as csvfile:
                    fieldnames = ['segment_id', 'word_index', 'word', 'start_time', 'end_time', 'probability']
                    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)
                    writer.writerows(word_rows)
            transcribed_count += 1

    print(f"Transcription saved to: {transcription_file}")
    print(f"Transcribed {transcribed_count} new segments")

if __name__ == "__main__":
    main()
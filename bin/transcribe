#!/usr/bin/env python3

import sys
import os
import csv
import json
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.transcript import Transcript
from halfhalf.prompts import build_prompts
from halfhalf.transcriber import Transcriber
from halfhalf.words import Words


def main():
    if len(sys.argv) != 2:
        print("Usage: transcribe <basename>")
        sys.exit(1)

    base_name = sys.argv[1]
    prompts = build_prompts(base_name)

    output_dir = os.path.join("output", base_name)
    timeline_file = os.path.join(output_dir, "timeline.csv")
    metadata_file = os.path.join(output_dir, "metadata.json")
    audio_dir = os.path.join(output_dir, "audio")

    # Check if required files exist
    if not os.path.exists(timeline_file):
        print(f"Error: Timeline CSV not found: {timeline_file}")
        print("Run 'diarize' first to generate the timeline.")
        sys.exit(1)

    if not os.path.exists(audio_dir):
        print(f"Error: Audio segments directory not found: {audio_dir}")
        print("Run 'cut-audio' first to generate audio segments.")
        sys.exit(1)

    print("Transcribing audio segments...")

    transcriber = Transcriber(prompts)

    # Load metadata for language hints and skip flags
    speaker_languages = {}
    speaker_skip = {}
    if os.path.exists(metadata_file):
        with open(metadata_file, 'r') as f:
            metadata = json.load(f)
            for speaker, data in metadata.items():
                speaker_languages[speaker] = data.get("language", "en")
                speaker_skip[speaker] = data.get("skip", False)

    # Load timeline data
    timeline_data = []
    with open(timeline_file, 'r') as csvfile:
        reader = csv.DictReader(csvfile)
        for row in reader:
            timeline_data.append(row)

    transcription_file = os.path.join(output_dir, "transcription.csv")
    words_file = os.path.join(output_dir, "words.csv")
    transcript = Transcript.load(transcription_file)
    words_csv = Words.load(words_file)

    # Transcribe each audio segment
    transcribed_count = 0

    for i, timeline_row in enumerate(timeline_data, 1):
        speaker_id = timeline_row['SPEAKER_ID']
        if speaker_skip.get(speaker_id, False):
            continue
        language = speaker_languages.get(speaker_id, "en")

        if not transcript.needs_transcription(i, language):
            continue

        segment_file = os.path.join(audio_dir, f"{i:06d}.mp3")

        if not os.path.exists(segment_file):
            print(f"Warning: Audio segment {segment_file} not found")
            continue

        print(f"Transcribing segment {i:06d} ({speaker_id})...")
        try:
            rows, words = transcriber.transcribe_segment(
                segment_file, i, speaker_id, language,
                timeline_row['start_time'], timeline_row['end_time'],
            )
        except Exception as e:
            print(f"Error transcribing segment {i:06d}: {e}")
            continue

        for row in rows:
            transcript.upsert(row)
        transcript.save()

        languages = {row['language'] for row in rows}
        words_csv.upsert_segment(i, words, languages)
        words_csv.save()

        transcribed_count += 1

    print(f"Transcription saved to: {transcription_file}")
    print(f"Transcribed {transcribed_count} new segments")

if __name__ == "__main__":
    main()
#!/usr/bin/env python3

import sys
import os
import json

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.timeline import Timeline
from halfhalf.language_detector import SerialLanguageDetector, ConcatenatingLanguageDetector

import whisper


def main():
    if len(sys.argv) != 2:
        print("Usage: detect-language <basename>")
        sys.exit(1)

    basename = sys.argv[1]
    timeline = Timeline.load(basename)
    speakers = sorted({s.speaker_id for s in timeline._segments})

    model = whisper.load_model("small")

    log_dir = os.path.join("output", basename, "language_detection")
    os.makedirs(log_dir, exist_ok=True)

    metadata_file = os.path.join("output", basename, "metadata.json")
    metadata = {}
    if os.path.exists(metadata_file):
        with open(metadata_file) as f:
            metadata = json.load(f)

    speaker_languages = {}

    for speaker_id in speakers:
        if metadata.get(speaker_id, {}).get("skip"):
            print(f"{speaker_id}: skipped (median segment duration too short)")
            continue

        segments = [s for s in timeline._segments if s.speaker_id == speaker_id]
        log_path = os.path.join(log_dir, f"{speaker_id}.log.json")
        concat_path = os.path.join(log_dir, f"{speaker_id}.concatenated.mp3")

        longest = max(s.duration for s in segments)

        if longest >= 2.0:
            detector = SerialLanguageDetector(segments)
            language = detector.detect(model)
            detector.write_log(log_path)
        else:
            language = None

        if language is None:
            detector = ConcatenatingLanguageDetector(segments)
            language = detector.detect(model, concat_path)
            detector.write_log(log_path)

        if language is None:
            language_entry = {"language": "?", "confidence": 0.0, "skip": True}
        else:
            language_entry = {"language": language, "confidence": 1.0, "skip": False}

        speaker_languages[speaker_id] = language_entry
        print(f"{speaker_id}: {language_entry['language']} (confidence: {language_entry['confidence']:.3f})")

    for speaker_id, lang_data in speaker_languages.items():
        metadata.setdefault(speaker_id, {}).update(lang_data)
    with open(metadata_file, "w") as f:
        json.dump(metadata, f, indent=2)

    print(f"Language metadata saved to: {metadata_file}")


if __name__ == "__main__":
    main()

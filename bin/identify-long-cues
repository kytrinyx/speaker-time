#!/usr/bin/env python3
"""Identify VTT cues that exceed HybridSplit line-length limits and write a todo-list.txt."""

import csv
import os
import re
import sys


def parse_timestamp(ts):
    m = re.match(r'(\d+):(\d+):(\d+\.\d+)', ts)
    if not m:
        return None
    return int(m.group(1)) * 3600 + int(m.group(2)) * 60 + float(m.group(3))


def is_korean(text):
    for ch in text:
        if '\uAC00' <= ch <= '\uD7A3' or '\u1100' <= ch <= '\u11FF' or '\u3130' <= ch <= '\u318F':
            return True
    return False


def parse_vtt_cues(vtt_file):
    with open(vtt_file) as f:
        content = f.read()
    lines = content.splitlines()
    i = 0
    while i < len(lines) and not re.match(r'\d+:\d+:\d+', lines[i]):
        i += 1
    cues = []
    current = []
    while i < len(lines):
        line = lines[i]
        if line.strip() == "":
            if current:
                m = re.match(r'([\d:\.]+)\s+-->\s+([\d:\.]+)', current[0])
                if m and len(current) >= 2:
                    cues.append((parse_timestamp(m.group(1)), parse_timestamp(m.group(2)), " ".join(current[1:])))
                current = []
        else:
            current.append(line)
        i += 1
    if current:
        m = re.match(r'([\d:\.]+)\s+-->\s+([\d:\.]+)', current[0])
        if m and len(current) >= 2:
            cues.append((parse_timestamp(m.group(1)), parse_timestamp(m.group(2)), " ".join(current[1:])))
    return cues


def main():
    if len(sys.argv) != 2:
        print("Usage: identify-long-cues <basename>")
        sys.exit(1)

    basename = sys.argv[1]
    vtt_file = os.path.join("output", basename, f"{basename}.vtt")
    transcription_file = os.path.join("output", basename, "transcription.csv")

    if not os.path.exists(vtt_file):
        print(f"Error: {vtt_file} not found")
        sys.exit(1)
    if not os.path.exists(transcription_file):
        print(f"Error: {transcription_file} not found")
        sys.exit(1)

    cues = parse_vtt_cues(vtt_file)

    violating = []
    for start, end, text in cues:
        lang = "ko" if is_korean(text) else "en"
        limit = 45 if lang == "ko" else 80
        if len(text) > limit:
            violating.append((start, end, text, lang, limit))

    segments = []
    with open(transcription_file) as f:
        for row in csv.DictReader(f):
            segments.append((int(row["segment_id"]), float(row["start_time"]), float(row["end_time"])))

    EPSILON = 0.02
    seen = set()
    segment_ids = []
    for cue_start, cue_end, text, lang, limit in violating:
        matched = None
        for seg_id, seg_start, seg_end in segments:
            if cue_start >= seg_start - EPSILON and cue_end <= seg_end + EPSILON:
                matched = seg_id
                break
        if matched is None:
            print(f"WARNING: no segment for cue [{cue_start:.3f}-{cue_end:.3f}]: {text[:60]}", file=sys.stderr)
        elif matched not in seen:
            seen.add(matched)
            segment_ids.append(matched)

    segment_ids.sort()

    todo_file = "todo-list.txt"
    with open(todo_file, "w") as f:
        for seg_id in segment_ids:
            f.write(f"./bin/split-cue {basename} {seg_id}\n")

    print(f"Found {len(violating)} violating cue(s) across {len(segment_ids)} segment(s). Written {todo_file}.")


if __name__ == "__main__":
    main()

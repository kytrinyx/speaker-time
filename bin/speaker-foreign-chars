#!/usr/bin/env python3
"""Show transcription segments with foreign characters for a specific speaker."""

import csv
import os
import sys


def is_allowed(ch):
    """Return True if character is ASCII or Korean."""
    if ord(ch) < 128:
        return True
    # Hangul syllables, jamo, compatibility jamo
    if '\uAC00' <= ch <= '\uD7A3':
        return True
    if '\u1100' <= ch <= '\u11FF':
        return True
    if '\u3130' <= ch <= '\u318F':
        return True
    return False


def has_foreign(text):
    return any(not is_allowed(ch) for ch in text)


def main():
    if len(sys.argv) != 3:
        print("Usage: speaker-foreign-chars <episode> <speaker>")
        print("Example: speaker-foreign-chars jeep-ep-023 SPEAKER_02")
        sys.exit(1)

    episode = sys.argv[1]
    speaker = sys.argv[2]

    transcription_file = os.path.join("output", episode, "transcription.csv")

    if not os.path.exists(transcription_file):
        print(f"Error: {transcription_file} not found", file=sys.stderr)
        sys.exit(1)

    count = 0
    with open(transcription_file, encoding='utf-8') as f:
        for row in csv.DictReader(f):
            if row['speaker_id'] != speaker:
                continue
            if has_foreign(row['text']):
                print(f"{row['segment_id']}: {row['text']}")
                count += 1

    print(f"\n{count} segment(s) with foreign characters for {speaker} in {episode}.")


if __name__ == '__main__':
    main()

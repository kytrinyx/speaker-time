#!/usr/bin/env python3
"""Find transcription.csv segments containing characters that are not English or Korean."""

import csv
import os
import sys


def is_allowed(ch):
    """Return True if character is ASCII or Korean."""
    if ord(ch) < 128:
        return True
    # Hangul syllables, jamo, compatibility jamo
    if '\uAC00' <= ch <= '\uD7A3':
        return True
    if '\u1100' <= ch <= '\u11FF':
        return True
    if '\u3130' <= ch <= '\u318F':
        return True
    return False


def has_foreign(text):
    return any(not is_allowed(ch) for ch in text)


def main():
    if len(sys.argv) != 2:
        print("Usage: find-foreign-chars <basename>")
        sys.exit(1)

    basename = sys.argv[1]
    transcription_file = os.path.join("output", basename, "transcription.csv")

    if not os.path.exists(transcription_file):
        print(f"Error: {transcription_file} not found", file=sys.stderr)
        sys.exit(1)

    todo_file = "todo-list.txt"
    count = 0
    with open(todo_file, "a") as out:
        with open(transcription_file, encoding='utf-8') as f:
            for row in csv.DictReader(f):
                if has_foreign(row['text']):
                    out.write(f"./tools/transcribe-cue {basename} {row['segment_id']}\n")
                    count += 1

    print(f"Found {count} segment(s) with foreign characters. Written {todo_file}.")


if __name__ == '__main__':
    main()

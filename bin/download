#!/usr/bin/env python3

import sys
import os
import glob
import json
import subprocess
from urllib.parse import urlparse, parse_qs

def main():
    if len(sys.argv) != 3:
        print("Usage: download <url> <--cohost>", file=sys.stderr)
        sys.exit(1)

    url = next((arg for arg in sys.argv[1:] if arg.startswith("http")), None)
    cohost_arg = next((arg for arg in sys.argv[1:] if arg.startswith("--")), None)

    if url is None:
        print("Could not identify URL. Must start with 'http'.", file=sys.stderr)
        sys.exit(1)

    if cohost_arg is None:
        print("Could not identify cohost. E.g. --jeep --katrina", file=sys.stderr)
        sys.exit(1)

    cohost = cohost_arg.lstrip("-")

    script_dir = os.path.dirname(os.path.abspath(__file__))
    project_root = os.path.dirname(script_dir)
    pattern = os.path.join(project_root, "output", f"{cohost}*")
    number = len(glob.glob(pattern)) + 1
    episode_id = f"{cohost}-ep-{number:03d}"

    parsed = urlparse(url)
    if parsed.hostname in ("youtu.be",):
        video_id = parsed.path.lstrip("/")
    else:
        video_id = parse_qs(parsed.query).get("v", [None])[0]

    audio_dir = os.path.join(project_root, "audio")
    os.makedirs(audio_dir, exist_ok=True)

    output_dir = os.path.join(project_root, "output", episode_id)
    os.makedirs(output_dir, exist_ok=True)

    title_result = subprocess.run(
        ["yt-dlp", "--print", "title", url],
        check=True,
        capture_output=True,
        text=True,
    )
    title = title_result.stdout.strip()

    metadata = {}
    if video_id:
        metadata["youtube_video_id"] = video_id
    if title:
        metadata["title"] = title
    if metadata:
        metadata_file = os.path.join(output_dir, "metadata.json")
        with open(metadata_file, "w") as f:
            json.dump(metadata, f, indent=2)

    mp3_path = os.path.join(audio_dir, f"{episode_id}.mp3")
    if os.path.exists(mp3_path):
        print(f"{episode_id} already exists at audio/{episode_id}.mp3", file=sys.stderr)
        sys.exit(1)

    subprocess.run(
        ["yt-dlp", "--extract-audio", "--audio-format=mp3",
         "-o", os.path.join(audio_dir, f"{episode_id}.%(ext)s"), url],
        check=True,
        stdout=sys.stderr,
    )
    print(episode_id)

if __name__ == "__main__":
    main()

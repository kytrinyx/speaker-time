#!/usr/bin/env python3

import sys
import os
import csv

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '../lib'))
from cue_splitter import (
    Word, Segment, Cue,
    normalize, split_text_at_punctuation, words_to_cue,
    PunctuationSplit, OllamaSplit, HybridSplit,
)

FIXTURE = "output/test-cues"


def load_fixture(path):
    words_by_segment = {}
    with open(f"{path}/words.csv") as f:
        for row in csv.DictReader(f):
            sid = int(row["segment_id"])
            words_by_segment.setdefault(sid, []).append(
                Word(row["word"], float(row["start_time"]), float(row["end_time"]))
            )

    segments = []
    with open(f"{path}/transcription.csv") as f:
        for row in csv.DictReader(f):
            text = row["text"].strip()
            if not text or text == "[TIMEOUT]":
                continue
            sid = int(row["segment_id"])
            segments.append(Segment(
                id=sid,
                start=float(row["start_time"]),
                end=float(row["end_time"]),
                text=text,
                language=row["language"],
                words=words_by_segment.get(sid, []),
            ))

    return sorted(segments, key=lambda s: s.id)


def format_ts(seconds):
    m, s = divmod(seconds, 60)
    return f"{int(m):02d}:{s:05.2f}"


def print_cues(cues):
    for cue in cues:
        print(f"    [{format_ts(cue.start)} → {format_ts(cue.end)}] {cue.text}")


def main():
    segments = load_fixture(FIXTURE)

    strategies = [
        PunctuationSplit(),
    ]

    for seg in segments:
        lang_label = seg.language.upper()
        word_count = len(seg.words)
        print(f"\n{'='*72}")
        print(f"Segment {seg.id} [{lang_label}] ({word_count} words)")
        print(f"  {seg.text}")
        print()

        for strategy in strategies:
            cues = strategy.split(seg)
            print(f"  -- {strategy.name} → {len(cues)} cue(s)")
            print_cues(cues)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3

import sys
import os
import subprocess

def run_script(script_name, audio_file):
    """Run a script with the audio file as argument."""
    script_path = os.path.join(os.path.dirname(__file__), script_name)

    if not os.path.exists(script_path):
        print(f"Error: Script {script_name} not found at {script_path}")
        sys.exit(1)

    print(f"\n=== Running {script_name} ===")
    result = subprocess.run([script_path, audio_file], check=True)
    return result.returncode == 0

def ensure_ollama_running():
    """Start ollama if it's not already running."""
    result = subprocess.run(["pgrep", "-x", "ollama"], capture_output=True)
    if result.returncode != 0:
        print("Starting ollama...")
        subprocess.Popen(["ollama", "serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def main():
    ensure_ollama_running()

    if len(sys.argv) != 3:
        print("Usage: process <url> <--cohost>", file=sys.stderr)
        sys.exit(1)

    download_path = os.path.join(os.path.dirname(__file__), "download")
    result = subprocess.run([download_path] + sys.argv[1:], capture_output=True, text=True)
    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        sys.exit(result.returncode)

    episode_id = result.stdout.strip()

    try:
        # Run the pipeline steps in order
        run_script("diarize", episode_id)
        run_script("cut-audio", episode_id)
        run_script("detect-language", episode_id)
        run_script("transcribe", episode_id)
        run_script("correct-intro-outro", episode_id)
        run_script("split-segments", episode_id)
        run_script("create-vtt", episode_id)
        run_script("translate-vtt", episode_id)

        subtitles_dir = os.environ.get("FINAL_HALF_AND_HALF_SUBTITLES_DIR", os.path.expanduser("~/Desktop/"))
        index_path = os.path.join(os.path.dirname(__file__), "..", "tools", "index")
        index_file = os.path.join(subtitles_dir, "_INDEX.txt")
        with open(index_file, "w") as f:
            subprocess.run([index_path], stdout=f, check=True)
        print(f"Index written to {index_file}")

        print(f"\n=== Pipeline completed successfully for {episode_id} ===")

    except subprocess.CalledProcessError as e:
        print(f"Error: Pipeline failed at step with exit code {e.returncode}")
        sys.exit(1)
    except KeyboardInterrupt:
        print("\nPipeline interrupted by user")
        sys.exit(1)

if __name__ == "__main__":
    main()

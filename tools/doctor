#!/usr/bin/env python3

import sys
import os
import shutil
import subprocess

repo_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def run(script, episode_id):
    result = subprocess.run([os.path.join(repo_dir, "bin", script), episode_id], cwd=repo_dir)
    if result.returncode != 0:
        print(f"Error running {script}")
        sys.exit(1)


def main():
    if len(sys.argv) != 2:
        print("Usage: doctor <episode_id>")
        sys.exit(1)

    episode_id = sys.argv[1]

    run("transcribe", episode_id)
    run("correct-intro-outro", episode_id)
    run("split-segments", episode_id)
    run("create-vtt", episode_id)

    output_dir = os.path.join(repo_dir, "output", episode_id)
    subtitles_dir = os.environ.get("FINAL_HALF_AND_HALF_SUBTITLES_DIR", os.path.expanduser("~/Desktop/"))
    for lang in ("ko", "en"):
        src = os.path.join(output_dir, f"{episode_id}.{lang}-{lang}.vtt")
        dst = os.path.join(subtitles_dir, f"{episode_id}.{lang}-{lang}.vtt")
        shutil.copy2(src, dst)
        print(f"Copied to {dst}")


if __name__ == "__main__":
    main()

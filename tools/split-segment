#!/usr/bin/env python3

import sys
import os
import csv
import json
from dataclasses import replace

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.word import Word
from halfhalf.segment_splitter import HybridSplit, PunctuationSplit, OllamaSplit, MAX_CHARS
from halfhalf.transcript import Transcript
from halfhalf import paths


def format_timestamp(seconds):
    hours = int(seconds // 3600)
    minutes = int((seconds % 3600) // 60)
    secs = seconds % 60
    return f"{hours:02d}:{minutes:02d}:{secs:06.3f}"


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    flags = [a for a in sys.argv[1:] if a.startswith("--")]

    if len(args) != 2:
        print("Usage: split-cue <episode_id> <segment_id> [--dry-run] [--debug]")
        print("Example: split-cue katrina-ep-009 973")
        sys.exit(1)

    episode_id = args[0]
    segment_id = int(args[1])
    dry_run = "--dry-run" in flags
    debug = "--debug" in flags

    words_file = paths.words_csv(episode_id)
    cache_file = paths.split_segments_json(episode_id)

    transcript = Transcript.load(episode_id)
    seg = next((s for s in transcript if s.id == segment_id), None)

    if seg is None:
        print(f"Error: segment {segment_id} not found in {transcript.path}")
        sys.exit(1)

    if not seg.text:
        print(f"Error: segment {segment_id} has no usable text")
        sys.exit(1)

    words = []
    if os.path.exists(words_file):
        with open(words_file) as f:
            for word_row in csv.DictReader(f):
                if int(word_row["segment_id"]) == segment_id and word_row.get("language") == seg.language:
                    words.append(Word(word_row["word"], float(word_row["start_time"]), float(word_row["end_time"])))

    segment = replace(seg, words=words)

    if debug:
        threshold = MAX_CHARS.get(seg.language, MAX_CHARS["default"])
        print(f"segment {segment_id}: {len(seg.raw_text)} chars (threshold {threshold}), {len(words)} words")
        if words:
            print(f"  words: {' '.join(w.text for w in words[:10])}{'...' if len(words) > 10 else ''}")
        print()

        punct_cues = PunctuationSplit().split(segment)
        print(f"PunctuationSplit → {len(punct_cues)} cue(s):")
        for c in punct_cues:
            flag = " [LONG]" if len(c.text) > threshold else ""
            print(f"  [{len(c.text):3d}]{flag} {c.text}")
        print()

        for c in punct_cues:
            if len(c.text) > threshold:
                cue_words = [w for w in words if w.end > c.start and w.start < c.end]
                print(f"OllamaSplit on: {c.text!r}")
                print(f"  {len(cue_words)} words passed to Ollama")
                import urllib.request, json as _json
                numbered = "\n".join(f"{i}: {w.text.strip()}" for i, w in enumerate(cue_words))
                prompt = (
                    "The following is a numbered list of words from a speech transcript.\n"
                    "Return all natural clause and phrase boundaries as a comma-separated list "
                    "of word indices where a new phrase begins. Include every possible boundary, "
                    "not just major splits. Do not include 0. Do not explain.\n\n"
                    f"{numbered}"
                )
                payload = _json.dumps({"model": "exaone3.5:latest", "prompt": prompt, "stream": False, "options": {"temperature": 0}}).encode()
                req = urllib.request.Request("http://localhost:11434/api/generate", data=payload, headers={"Content-Type": "application/json"})
                try:
                    with urllib.request.urlopen(req, timeout=120) as resp:
                        result = _json.loads(resp.read())
                    raw = result["response"].strip()
                    print(f"  Ollama raw response: {raw!r}")
                except Exception as e:
                    print(f"  Ollama error: {e}")
                print()

    cues = HybridSplit(episode_id=episode_id).split(segment)

    if dry_run:
        for cue in cues:
            print(f"{format_timestamp(cue.start)} --> {format_timestamp(cue.end)}")
            print(cue.text)
            print()
    else:
        cache = {}
        if os.path.exists(cache_file):
            with open(cache_file) as f:
                cache = json.load(f)

        cache[str(segment_id)] = {
            "source": seg.raw_text,
            "cues": [{"text": c.text, "start": c.start, "end": c.end} for c in cues],
        }

        os.makedirs(os.path.dirname(cache_file), exist_ok=True)
        with open(cache_file, "w") as f:
            json.dump(cache, f, ensure_ascii=False, indent=2)

        print(f"Updated split_segments.json: segment {segment_id} → {len(cues)} cue{'s' if len(cues) != 1 else ''}")


if __name__ == "__main__":
    main()

#!/usr/bin/env python3

import sys
import os
import json
import glob

scripts_dir = os.path.dirname(os.path.abspath(__file__))
repo_dir = os.path.dirname(scripts_dir)

output_dir = os.path.join(repo_dir, "output")

for episode_dir in sorted(glob.glob(os.path.join(output_dir, "*"))):
    episode_id = os.path.basename(episode_dir)
    metadata_file = os.path.join(episode_dir, "metadata.json")
    if not os.path.exists(metadata_file):
        continue
    with open(metadata_file) as f:
        metadata = json.load(f)
    video_id = metadata.get("youtube_video_id")
    if not video_id:
        continue
    print(f"{episode_id},{video_id}")

#!/usr/bin/env python3

import os
import sys

repo_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, repo_dir)
from halfhalf.transcript import Transcript

INTRO_KO_LINES = 5
OUTRO_LINES = 15

if len(sys.argv) != 2:
    print("Usage: extract-intro-outros <basename>")
    sys.exit(1)

episode_id = sys.argv[1]
output_dir = os.path.join("output", episode_id)

if not os.path.exists(os.path.join(output_dir, "timeline.csv")):
    print(f"Error: {output_dir}/timeline.csv not found")
    sys.exit(1)

transcript = Transcript.load(os.path.join(output_dir, "transcription.csv"))
segments = [row for row in transcript if row["text"].strip()]

# Intro: first 50 Korean segments
intro_ko = []
for row in segments:
    if row["language"] == "ko":
        intro_ko.append(row["text"].strip())
    if len(intro_ko) >= INTRO_KO_LINES:
        break

# Outro: last 100 segments, split by language
outro_segments = segments[-OUTRO_LINES:]
outro_ko = [row["text"].strip() for row in outro_segments if row["language"] == "ko"]
outro_en = [row["text"].strip() for row in outro_segments if row["language"] == "en"]

log_path = os.path.join(output_dir, "intro-outro.log")
with open(log_path, "w") as log:
    if intro_ko:
        log.write(f"{episode_id}: {' '.join(intro_ko)}\n")
    if outro_ko:
        log.write(f"{episode_id}: {' '.join(outro_ko)}\n")
    if outro_en:
        log.write(f"{episode_id}: {' '.join(outro_en)}\n")

print(f"Wrote {log_path}")

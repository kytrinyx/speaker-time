#!/usr/bin/env python3

import sys
import os
import csv
import json
import datetime

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '../lib'))
from transcript import Transcript
from prompts import build_prompts
from transcriber import Transcriber



def main():
    if len(sys.argv) != 3:
        print("Usage: transcribe-cue <basename> <segment_id>")
        sys.exit(1)

    base_name = sys.argv[1]
    segment_id = int(sys.argv[2])
    prompts = build_prompts(base_name)

    output_dir = os.path.join("output", base_name)
    timeline_file = os.path.join(output_dir, "timeline.csv")
    metadata_file = os.path.join(output_dir, "metadata.json")
    transcription_file = os.path.join(output_dir, "transcription.csv")
    words_file = os.path.join(output_dir, "words.csv")
    audio_file = os.path.join(output_dir, "audio", f"{segment_id:06d}.mp3")

    os.makedirs("logs", exist_ok=True)
    log_file = os.path.join("logs", f"transcribe-cue.{base_name}.log")

    for path in [timeline_file, transcription_file, audio_file]:
        if not os.path.exists(path):
            print(f"Error: {path} not found")
            sys.exit(1)

    # Read timeline row for this segment
    timeline_row = None
    with open(timeline_file) as f:
        for row in csv.DictReader(f):
            if int(row.get('segment_id', 0)) == segment_id:
                timeline_row = row
                break

    # Fall back: timeline.csv may use positional index (1-based row number) without segment_id column
    if timeline_row is None:
        with open(timeline_file) as f:
            reader = csv.DictReader(f)
            for i, row in enumerate(reader, 1):
                if i == segment_id:
                    timeline_row = row
                    break

    if timeline_row is None:
        print(f"Error: segment {segment_id} not found in {timeline_file}")
        sys.exit(1)

    speaker_id = timeline_row['SPEAKER_ID']
    start_time = float(timeline_row['start_time'])
    end_time = float(timeline_row['end_time'])

    # Get language from metadata
    language = "en"
    if os.path.exists(metadata_file):
        with open(metadata_file) as f:
            metadata = json.load(f)
            speaker_data = metadata.get(speaker_id, {})
            language = speaker_data.get("language", "en")

    transcript = Transcript.load(transcription_file)

    if not transcript.needs_transcription(segment_id, language):
        existing_confidence = float(transcript._rows[(segment_id, language)]['confidence'])
        print(f"Segment {segment_id:06d} ({speaker_id}, {language}) confidence is {existing_confidence:.4f} (good), skipping.")
        return

    print(f"Retranscribing segment {segment_id:06d} ({speaker_id}, {language})...")

    before_text = next((row['text'] for row in transcript if int(row['segment_id']) == segment_id), None)

    transcriber = Transcriber(prompts)
    all_rows, all_words = transcriber.transcribe_segment(
        audio_file, segment_id, speaker_id, language, start_time, end_time
    )

    for row in all_rows:
        transcript.upsert(row)
    transcript.save()

    print(f"Updated transcription.csv")

    after_text = next((row['text'] for row in transcript if int(row['segment_id']) == segment_id), None)
    timestamp = datetime.datetime.now().isoformat(timespec='seconds')
    with open(log_file, 'a') as f:
        f.write(f"[{timestamp}] segment {segment_id:06d}\n")
        f.write(f"  before: {before_text}\n")
        f.write(f"  after:  {after_text}\n")
        if len(all_rows) > 1:
            for row in all_rows:
                f.write(f"  [{row['language']}] confidence={float(row['confidence']):.4f} text={row['text'][:80]}\n")

    # Upsert words.csv
    words_fieldnames = ['segment_id', 'language', 'word_index', 'word', 'start_time', 'end_time', 'probability']
    languages_written = {row['language'] for row in all_words}
    existing_words = []
    if os.path.exists(words_file):
        with open(words_file) as f:
            for row in csv.DictReader(f):
                if not (int(row['segment_id']) == segment_id and row.get('language') in languages_written):
                    row.setdefault('language', '')
                    existing_words.append(row)

    with open(words_file, 'w', newline='') as f:
        writer = csv.DictWriter(f, fieldnames=words_fieldnames)
        writer.writeheader()
        writer.writerows(existing_words)
        writer.writerows(all_words)

    print(f"Updated words.csv ({len(all_words)} word rows)")


if __name__ == "__main__":
    main()

#!/usr/bin/env python3

import sys
import os
import csv
import json
import datetime

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from halfhalf.transcript import Transcript
from halfhalf.prompts import build_prompts
from halfhalf.transcriber import Transcriber
from halfhalf.words import Words



def main():
    if len(sys.argv) != 3:
        print("Usage: transcribe-cue <episode_id> <segment_id>")
        sys.exit(1)

    episode_id = sys.argv[1]
    segment_id = int(sys.argv[2])
    prompts = build_prompts(episode_id)

    output_dir = os.path.join("output", episode_id)
    timeline_file = os.path.join(output_dir, "timeline.csv")
    metadata_file = os.path.join(output_dir, "metadata.json")
    words_file = os.path.join(output_dir, "words.csv")
    audio_file = os.path.join(output_dir, "audio", f"{segment_id:06d}.mp3")

    os.makedirs("logs", exist_ok=True)
    log_file = os.path.join("logs", f"transcribe-cue.{episode_id}.log")

    transcript = Transcript.load(episode_id)

    for path in [timeline_file, transcript.path, audio_file]:
        if not os.path.exists(path):
            print(f"Error: {path} not found")
            sys.exit(1)

    # Read timeline row for this segment
    timeline_row = None
    with open(timeline_file) as f:
        for row in csv.DictReader(f):
            if int(row.get('segment_id', 0)) == segment_id:
                timeline_row = row
                break

    # Fall back: timeline.csv may use positional index (1-based row number) without segment_id column
    if timeline_row is None:
        with open(timeline_file) as f:
            reader = csv.DictReader(f)
            for i, row in enumerate(reader, 1):
                if i == segment_id:
                    timeline_row = row
                    break

    if timeline_row is None:
        print(f"Error: segment {segment_id} not found in {timeline_file}")
        sys.exit(1)

    speaker_id = timeline_row['SPEAKER_ID']
    start_time = float(timeline_row['start_time'])
    end_time = float(timeline_row['end_time'])

    # Get language from metadata
    language = "en"
    if os.path.exists(metadata_file):
        with open(metadata_file) as f:
            metadata = json.load(f)
            speaker_data = metadata.get(speaker_id, {})
            language = speaker_data.get("language", "en")

    words = Words.load(words_file)
    transcriber = Transcriber(prompts, transcript, words)

    if not transcriber.needs_transcription(segment_id, language):
        print(f"Segment {segment_id:06d} ({speaker_id}, {language}) does not need transcription, skipping.")
        return

    print(f"Retranscribing segment {segment_id:06d} ({speaker_id}, {language})...")

    before_text = next((row['text'] for row in transcript if int(row['segment_id']) == segment_id), None)
    all_rows, all_words = transcriber.transcribe_segment(
        audio_file, segment_id, speaker_id, language, start_time, end_time
    )

    for row in all_rows:
        transcript.upsert(row)
    transcript.save()

    print(f"Updated transcription.csv")

    after_text = next((row['text'] for row in transcript if int(row['segment_id']) == segment_id), None)
    timestamp = datetime.datetime.now().isoformat(timespec='seconds')
    with open(log_file, 'a') as f:
        f.write(f"[{timestamp}] segment {segment_id:06d}\n")
        f.write(f"  before: {before_text}\n")
        f.write(f"  after:  {after_text}\n")
        if len(all_rows) > 1:
            for row in all_rows:
                f.write(f"  [{row['language']}] confidence={float(row['confidence']):.4f} text={row['text'][:80]}\n")

    languages = {row['language'] for row in all_rows}
    words.upsert_segment(segment_id, all_words, languages)
    words.save()
    print(f"Updated words.csv ({len(all_words)} word rows)")


if __name__ == "__main__":
    main()
